# Application infrastructure only. Do not put per-band API keys/tokens here.
# Existing installation settings remain in its protected .env.
# Store a newline-separated Fernet key ring outside Git/DB; first key encrypts.
BANDMATE_SECRET_KEY_FILE=/etc/bandmate/credential-keys

# Separate registered HTTPS OAuth callbacks. Supply client secrets securely.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=https://YOUR_HOST/calendar/manage/google/callback/
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REDIRECT_URI=https://YOUR_HOST/booking/gmail/callback/

# Comma-separated model IDs verified by the operator. Empty disables selection.
BOOKING_OPENAI_MODELS=
