[Unit]
Description=BandMate Booking Research Scheduler and Retention Cleanup
After=network-online.target

[Service]
Type=oneshot
User=@SERVICE_USER@
WorkingDirectory=@APP_DIR@
EnvironmentFile=@APP_DIR@/.env
ExecStart=@APP_DIR@/.venv/bin/python manage.py booking_enqueue_due
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
