[Unit]
Description=BandMate Google Calendar Sync (foundation)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=@SERVICE_USER@
WorkingDirectory=@APP_DIR@
EnvironmentFile=@APP_DIR@/.env
ExecStart=@APP_DIR@/.venv/bin/python manage.py sync_google_calendars
TimeoutStartSec=5min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
